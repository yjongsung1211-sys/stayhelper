{
  "appId": "com.yoonjongsung.antigravity",
  "appName": "Antigravity",
  "webDir": "out",
  "server": {
    "url": "https://secondbrain-note.vercel.app/antigravity",
    "cleartext": true,
    "allowNavigation": [
      "secondbrain-note.vercel.app",
      "*.vercel.app",
      "*.trycloudflare.com",
      "127.0.0.1",
      "192.168.*.*"
    ]
  },
  "android": {
    "allowMixedContent": true,
    "captureInput": true,
    "webContentsDebuggingEnabled": true,
    "backgroundColor": "#0B0F17"
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    }
  }
}
